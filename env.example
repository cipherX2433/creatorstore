# ==================================================
# CREATORSTORE ENVIRONMENT CONFIGURATION (.env.example)
# ==================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# JWT & Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_32_character_secret

# Supabase Database & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==================================================
# RAZORPAY PAYMENT GATEWAY (LIVE / TEST)
# ==================================================
# Mode: "live" for production, "test" for sandbox testing
# RAZORPAY_ENV is an alias for RAZORPAY_MODE (test | live)
RAZORPAY_MODE=live
# RAZORPAY_ENV=test

# Server-Side API Credentials (NEVER expose to browser)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_live_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret_here

# Client-Side Public Key (Only the Key ID, NEVER the secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx

# Local-only mock payout IDs. Ignored unless NODE_ENV=development AND keys are not rzp_live_.
# Never set this in staging/production.
# RAZORPAY_MOCK=true

# ==================================================
# CREATORSTORE SUBSCRIPTION PRICING (INR)
# ==================================================
# Change prices here without touching source code
CREATOR_PLAN_PRICE_INR=1
PRO_PLAN_PRICE_INR=499

# Public mirrors for client-side pricing display
NEXT_PUBLIC_CREATOR_PLAN_PRICE_INR=1
NEXT_PUBLIC_PRO_PLAN_PRICE_INR=499

# Fallback aliases
STARTER_PRICE_INR=1
PRO_PRICE_INR=499

# Optional Razorpay Subscription Plan IDs (if using recurring plans)
RAZORPAY_CREATOR_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=

# Subscription Currency (INR or USD)
RAZORPAY_SUBSCRIPTION_CURRENCY=INR

# Platform Fee Percentage (0 for zero platform fee)
PLATFORM_FEE_PERCENTAGE=0

# ==================================================
# EMAIL NOTIFICATIONS (RESEND HTTPS API) & SUPPORT
# ==================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="CreatorStore <noreply@creatorstore.store>"
EMAIL_REPLY_TO=support@creatorstore.store
SUPPORT_EMAIL=support@creatorstore.store
NEXT_PUBLIC_SUPPORT_EMAIL=support@creatorstore.store

# ==================================================
# META / INSTAGRAM AUTODM (OPTIONAL)
# ==================================================
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_secure_meta_webhook_verify_token

# ==================================================
# GOOGLE ANALYTICS 4 (GA4) & GOOGLE TAG MANAGER (GTM)
# ==================================================
# Set your GA4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Set your GTM Container ID (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Master switch to enable/disable analytics (default: true in production, false if not set/local)
NEXT_PUBLIC_ANALYTICS_ENABLED=true
# Enable verbose [Analytics] console logs for local verification (default: false)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

