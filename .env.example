# ==========================================
# CreatorStore Environment Variables (.env.example)
# ==========================================

# Database & Supabase Configuration
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# App & Domain Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# DODO PAYMENTS (SOLE ACTIVE PAYMENT PROVIDER)
# Documentation: https://docs.dodopayments.com/
# Environments: test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_API_KEY="your_dodo_api_key_here"
DODO_PAYMENTS_WEBHOOK_KEY="whsec_your_dodo_webhook_key_here"

# Dodo Subscription Products & Price IDs
# Creator Plan: $6/mo ($58/yr) or ₹499/mo (₹4,790/yr)
DODO_PRODUCT_CREATOR_MONTHLY_ID="p_creator_monthly"
DODO_PRODUCT_CREATOR_ANNUAL_ID="p_creator_annual"
DODO_PRODUCT_CREATOR_INR_MONTHLY_ID="p_creator_inr_monthly"
DODO_PRODUCT_CREATOR_INR_ANNUAL_ID="p_creator_inr_annual"

# Pro Plan: $12/mo ($115/yr) or ₹999/mo (₹9,590/yr)
DODO_PRODUCT_PRO_MONTHLY_ID="p_pro_monthly"
DODO_PRODUCT_PRO_ANNUAL_ID="p_pro_annual"
DODO_PRODUCT_PRO_INR_MONTHLY_ID="p_pro_inr_monthly"
DODO_PRODUCT_PRO_INR_ANNUAL_ID="p_pro_inr_annual"

# Optional return and cancel URLs
# DODO_RETURN_URL_BASE="http://localhost:3000"
# DODO_CANCEL_URL="http://localhost:3000/dashboard/settings/billing?canceled=true"

# Authentication & Session
JWT_SECRET="your_jwt_secret_min_32_chars"

# Email Delivery (Resend / SMTP)
RESEND_API_KEY="re_your_resend_api_key"
FROM_EMAIL="CreatorStore <hello@yourdomain.com>"

# RAZORPAY SUBSCRIPTION PAYMENTS (INDIA ROUTING)
# Test mode credentials: rzp_test_... | Live mode credentials: rzp_live_...
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Razorpay Subscription Plan IDs (INR Recurring Mandates)
RAZORPAY_CREATOR_PLAN_ID="plan_creator_inr_monthly"
RAZORPAY_PRO_PLAN_ID="plan_pro_inr_monthly"

# Razorpay Subscription Lifecycle & Failure Handling
RAZORPAY_PENDING_SUBSCRIPTION_TIMEOUT_MINUTES=60
RAZORPAY_SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Background Scheduler & Cron Secret
CRON_SECRET="your_cron_bearer_secret"

